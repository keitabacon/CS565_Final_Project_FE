<MudTable T="ScheduledGame" Items="@Games" Breakpoint="Breakpoint.Sm" Dense="true">
    <HeaderContent>
        <MudTh>Time</MudTh>
        <MudTh>Matchup</MudTh>
        <MudTh>Field</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Time">@context.Time</MudTd>
        <MudTd DataLabel="Matchup">@context.Matchup</MudTd>
        <MudTd DataLabel="Field">@context.Field</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No matches scheduled for this day.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IEnumerable<ScheduledGame> Games { get; set; } = [];
}
