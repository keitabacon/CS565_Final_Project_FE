@page "/information"
@rendermode InteractiveServer
@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@* Enable these directives when switching to the API.
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
*@

<PageTitle>@(_info?.TournamentName ?? "Tournament Information")</PageTitle>

@if (_info is { } info)
{
    <h1>@info.TournamentName</h1>
    <p>@FormatDateRange(info.StartDate, info.EndDate)</p>

    <h2>Scoring rules</h2>
    <MudTable T="ScoringRule" Items="@info.ScoringRules"
              Breakpoint="Breakpoint.Sm" Dense="true">
        <HeaderContent>
            <MudTh>Result</MudTh>
            <MudTh>Points</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Result">@context.PointName</MudTd>
            <MudTd DataLabel="Points">@context.PointValue</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <h1>Tournament Information</h1>
    <p role="status">@(_loading ? "Loading tournament information…" : "Tournament information is unavailable.")</p>
}

@code {
    private static readonly JsonSerializerOptions InfoJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower
    };

    private TournamentInfo? _info;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // API example. Replace the fixture-loading block below when enabling this.
        // var client = HttpClientFactory.CreateClient("TournamentApi");
        // _info = await client.GetFromJsonAsync<TournamentInfo>(
        //     "tournaments/1/info", InfoJsonOptions);

        var file = WebHostEnvironment.WebRootFileProvider.GetFileInfo("data/tournaments/1/info.json");
        if (file.Exists)
        {
            await using var stream = file.CreateReadStream();
            _info = await JsonSerializer.DeserializeAsync<TournamentInfo>(stream, InfoJsonOptions);
        }

        _loading = false;
    }

    private static string FormatDateRange(DateOnly start, DateOnly end)
    {
        if (start == end)
        {
            return start.ToString("MMMM d, yyyy");
        }

        if (start.Year == end.Year && start.Month == end.Month)
        {
            return $"{start:MMMM d}–{end:d, yyyy}";
        }

        return $"{start:MMMM d, yyyy} – {end:MMMM d, yyyy}";
    }

    private sealed record TournamentInfo(
        string TournamentName,
        DateOnly StartDate,
        DateOnly EndDate,
        List<ScoringRule> ScoringRules);

    private sealed record ScoringRule(string PointName, int PointValue);
}
